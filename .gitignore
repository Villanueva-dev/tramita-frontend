.next/
.DS_Store

# Lo genera Next en cada `dev`, `build` o `typegen`, y su contenido es un detalle de
# implementación: alterna entre `.next/dev/types` y `.next/types` según el último comando,
# así que aparecía modificado sin que nadie lo editara. La documentación de Next pide
# ignorarlo y quitarlo de git si el proyecto ya lo rastreaba; debe seguir declarado en el
# `include` de tsconfig.json, y lo está.
# https://nextjs.org/docs/app/api-reference/config/typescript
next-env.d.ts

# Local tooling artifacts (not part of the delivery)
.codegraph/
.atl/
*.tsbuildinfo
# Notas de trabajo locales: no viajan al repositorio público.
notas-locales/
.pi/
